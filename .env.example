# Copy this file to .env and fill in the values. Never commit .env.

# LLM provider: "anthropic" (real model) or "mock" (keyword rules, no API key needed)
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Model used for classification
LLM_MODEL=claude-haiku-4-5-20251001

# Seconds to wait for the model before giving up on an attempt
LLM_TIMEOUT_SECONDS=30

# Extra attempts after a timeout or an invalid response
LLM_MAX_RETRIES=2

# SQLite database file
DATABASE_PATH=pitz_pulse.db
